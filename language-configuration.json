{
  "comments": { "lineComment": "&&" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(define\\s+class|((protected|hidden)\\s+)?(function|procedure)|if|else|do\\s+case|case|otherwise|for|do\\s+while|scan|with|try|catch|finally|text)\\b(?!\\s*=).*$",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(enddefine|endfunc|endproc|endif|else|endcase|case|otherwise|endfor|next|enddo|endscan|endwith|catch|finally|endtry|endtext)\\b.*$",
      "flags": "i"
    }
  }
}
