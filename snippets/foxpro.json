{
  "NOTE docstring": {
    "prefix": "note",
    "description": "Bloque NOTE de documentación (docstring) para la función siguiente",
    "body": [
      "NOTE\t[${1|Dependencia,Extension,Generacion,Contrato,Gotcha,Obsoleto|}] ${2:Resumen de qué hace}. ;",
      "\t\tParametros: ;",
      "\t\t\t${3:tcParametro} - ${4:Descripción}. ;",
      "\t\tRetorna: ${5:String} - ${6:Descripción}.",
      "$0"
    ]
  },
  "NOTE docstring sin parámetros": {
    "prefix": "notes",
    "description": "Bloque NOTE de una línea (sin parámetros ni retorno)",
    "body": ["NOTE\t[${1|Dependencia,Extension,Generacion,Contrato,Gotcha,Obsoleto|}] ${2:Resumen de qué hace}.", "$0"]
  },
  "Función documentada": {
    "prefix": "funcnote",
    "description": "Separador, NOTE y función",
    "body": [
      "*-----------------------------------------------------------------------------------------",
      "NOTE\t[${1|Dependencia,Extension,Generacion,Contrato,Gotcha|}] ${2:Resumen}. ;",
      "\t\tParametros: ;",
      "\t\t\t${4:tcParametro} - ${5:Descripción}. ;",
      "\t\tRetorna: ${6:String} - ${7:Descripción}.",
      "function ${3:Nombre}( ${4:tcParametro} as String ) as ${6:String}",
      "\t$0",
      "endfunc"
    ]
  }
}
